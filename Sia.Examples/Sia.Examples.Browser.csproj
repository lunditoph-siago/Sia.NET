<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <WasmEnableThreads>true</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj_desktop\**" />
    <EmbeddedResource Remove="obj_desktop\**" />
    <None Remove="obj_desktop\**" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia\Sia.csproj" />
    <ProjectReference Include="..\Sia.CodeGenerators\Sia.CodeGenerators.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="..\Sia.Prelude\Sia.Prelude.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" />
    <PackageReference Include="Sia.Spirv.Compiler" Version="0.0.24" />
    <PackageReference Include="Sia.Math" Version="0.0.4" />
    <PackageReference Include="Sia.Window" Version="0.0.8" />
    <PackageReference Include="Sia.Input" Version="0.0.8" />
    <PackageReference Include="Sia.Graphics" Version="0.0.24" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="*.notebook.xml">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sMALLOC=mimalloc</EmccExtraLDFlags>
  </PropertyGroup>

  <!-- The recovery page needs the loading screen before it knows the application base URL. -->
  <Target Name="ExpandBootScreen" BeforeTargets="ResolveProjectStaticWebAssets">
    <PropertyGroup>
      <_BootScreenStyle>&lt;style id="boot-screen-style"&gt;$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Browser/BootScreen.css'))&lt;/style&gt;</_BootScreenStyle>
      <_BootScreenMarkup>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Browser/BootScreen.html'))</_BootScreenMarkup>
    </PropertyGroup>
    <ItemGroup>
      <_BootPage Include="wwwroot/index.html;wwwroot/404.html" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)boot-pages/%(_BootPage.Filename).html"
                      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(_BootPage.FullPath)').Replace('&lt;!-- boot-screen-style --&gt;', '$(_BootScreenStyle)').Replace('&lt;!-- boot-screen --&gt;', '$(_BootScreenMarkup)'))))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Content Remove="@(_BootPage)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <Content Include="$([MSBuild]::NormalizePath('$(IntermediateOutputPath)', 'boot-pages', 'index.html'))"
               Link="wwwroot/index.html" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$([MSBuild]::NormalizePath('$(IntermediateOutputPath)', 'boot-pages', '404.html'))"
               Link="wwwroot/404.html" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="@(_BootPage->'$(IntermediateOutputPath)boot-pages/%(Filename).html')" />
    </ItemGroup>
  </Target>

</Project>
