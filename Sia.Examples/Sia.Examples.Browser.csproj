<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <WasmEnableThreads>true</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj_desktop\**" />
    <EmbeddedResource Remove="obj_desktop\**" />
    <None Remove="obj_desktop\**" />
  </ItemGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sia\Sia.csproj" />
    <ProjectReference Include="..\Sia.CodeGenerators\Sia.CodeGenerators.csproj" OutputItemType="Analyzer" />
    <ProjectReference Include="..\Sia.Prelude\Sia.Prelude.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Sia.Spirv.Compiler" Version="0.0.23" />
    <PackageReference Include="Sia.Math" Version="0.0.4" />
    <PackageReference Include="Sia.Window" Version="0.0.8" />
    <PackageReference Include="Sia.Input" Version="0.0.8" />
    <PackageReference Include="Sia.Graphics" Version="0.0.23" />
    <PackageReference Include="Sia.WebGPU.Native" Version="0.0.23" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="*.notebook.xml">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 0.0.23 packages its build targets under net461, which NuGet cannot select for browser. -->
  <Import Project="$(PkgSia_WebGPU_Native)\buildTransitive\net461\Sia.WebGPU.Native.targets"
          Condition="'$(PkgSia_WebGPU_Native)' != ''" />

  <PropertyGroup>
    <!-- Roslyn and native rendering allocate concurrently; avoid dlmalloc's shared allocation lock. -->
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sOFFSCREENCANVAS_SUPPORT=1 -sMALLOC=mimalloc</EmccExtraLDFlags>
  </PropertyGroup>
  <ItemGroup>
    <NativeFileReference Include="Browser\PipelineCanvas.c" />
    <Content Include="Browser\PipelineCanvas.library.js" Kind="js-library" />
  </ItemGroup>

  <Target Name="RegisterBrowserWebGpu" BeforeTargets="_GenerateManagedToNative"
          DependsOnTargets="PrepareForWasmBuildNative">
    <ItemGroup>
      <_WasmPInvokeModules Include="__Internal_emscripten" />
    </ItemGroup>
  </Target>

</Project>
